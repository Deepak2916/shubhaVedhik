# Copy to .env.local and fill in. Only the public anon key belongs here —
# NEVER put the service-role key in any VITE_ variable (it would ship to browsers).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Public origin used in QR codes and share links (no trailing slash)
VITE_SITE_URL=http://localhost:5173
